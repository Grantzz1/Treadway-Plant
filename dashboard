dashboard_html = r"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>TP Owner Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--g:#234d32;--c:#faf7ef;--l:#ded9cd;--t:#233027}
*{box-sizing:border-box}body{margin:0;background:var(--c);color:var(--t);font-family:Arial,sans-serif}header{background:var(--g);color:#fff;padding:28px 20px}header h1{margin:0}
main{max-width:1050px;margin:auto;padding:25px 18px}.card{background:#fff;border:1px solid var(--l);border-radius:18px;padding:20px;margin-bottom:20px}
h2{color:var(--g)}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px}.plant{border:1px solid var(--l);border-radius:14px;padding:16px}.plant h3{color:var(--g)}
label{display:block;font-weight:700;margin-top:10px}input{width:100%;padding:10px;border:1px solid #cfc9bb;border-radius:9px;font:inherit}
button{border:0;border-radius:999px;padding:11px 17px;font-weight:700;cursor:pointer}.primary{background:var(--g);color:#fff}.secondary{background:#eee}
.row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px}.muted{color:#667069;font-size:.9rem}.status{font-weight:700;margin-top:12px;display:inline-block}.green{color:#28723e}.yellow{color:#9a7000}.red{color:#a22}
.notice{padding:14px;border-radius:12px;background:#fff3cd;border:1px solid #e4c75c}.success{background:#edf5ea;border-color:#bdd8b7}.error{background:#fdeaea;border-color:#e0b0b0}.hidden{display:none}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.userbar{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
@media(max-width:600px){.row{grid-template-columns:1fr}}
</style>
</head>
<body>
<header><h1>🌱 Treadway Plants — Owner Dashboard</h1><p>Inventory Manager</p></header>
<main>
<div id="setup" class="card"><h2>🔧 Connect Dashboard</h2><p class="muted">Enter the Supabase publishable key. Never enter a database password or secret/service-role key.</p>
<label>Project URL<input id="url" value="https://hywvsvplhwdikxvcxavd.supabase.co"></label>
<label>Publishable Key<input id="key" type="password" placeholder="sb_publishable_..."></label>
<div class="actions"><button class="primary" onclick="connect()">Connect</button></div><p id="setupMsg" class="notice hidden"></p></div>

<div id="login" class="card hidden"><h2>🔐 Owner Login</h2><label>Email<input id="email" type="email"></label><label>Password<input id="pass" type="password"></label>
<div class="actions"><button class="primary" onclick="signIn()">Sign In</button></div><p id="loginMsg" class="notice hidden"></p></div>

<div id="app" class="hidden"><div class="card"><div class="userbar"><div><b>Owner: <span id="who"></span></b></div><button class="secondary" onclick="signOut()">Sign Out</button></div></div>
<div id="msg" class="notice hidden"></div>
<div class="card"><h2>📦 Manage Inventory</h2><p class="muted">These numbers are what customers can see on the public website.</p><div id="plants" class="grid"></div>
<div class="actions"><button class="primary" onclick="save()">💾 Save Inventory</button><button class="secondary" onclick="load()">↻ Reload</button></div></div>
</div></main>
<script>
const names=["Basil","Parsley","Oregano","Mint","Tomato","Peppers","Watermelon","Pumpkin","Corn","Pansy","Marigold","Petunia","Zinnia","Calendula","Viola","Dianthus","Lavender"];
let sb,user;const E=id=>document.getElementById(id);
function notice(id,text,type=""){E(id).textContent=text;E(id).className="notice "+type;E(id).classList.remove("hidden")}
function connect(){const u=E("url").value.trim(),k=E("key").value.trim();if(!u||!k){notice("setupMsg","Enter both fields.","error");return}sb=window.supabase.createClient(u,k);localStorage.setItem("tp_url",u);localStorage.setItem("tp_key",k);E("setup").classList.add("hidden");E("login").classList.remove("hidden")}
async function signIn(){const {data,error}=await sb.auth.signInWithPassword({email:E("email").value.trim(),password:E("pass").value});if(error){notice("loginMsg",error.message,"error");return}user=data.user;E("login").classList.add("hidden");E("app").classList.remove("hidden");E("who").textContent=user.email||"";load()}
async function signOut(){await sb.auth.signOut();location.reload()}
function render(rows){const m={};(rows||[]).forEach(r=>m[r.plant_name]=r);E("plants").innerHTML=names.map((n,i)=>{const r=m[n]||{};return `<div class="plant"><h3>${n}</h3><div class="row">
<label>Seedling<input id="s${i}" type="number" min="0" value="${r.seedling||0}" oninput="status(${i})"></label>
<label>Growing<input id="g${i}" type="number" min="0" value="${r.growing||0}" oninput="status(${i})"></label>
<label>Established<input id="e${i}" type="number" min="0" value="${r.established||0}" oninput="status(${i})"></label>
</div><label><input id="p${i}" type="checkbox" ${r.is_public!==false?"checked":""}> Show on public inventory</label><span id="st${i}" class="status"></span></div>`}).join("");names.forEach((n,i)=>status(i))}
async function load(){const {data,error}=await sb.from("Inventory").select("plant_name,seedling,growing,established,is_public").eq("owner_id",user.id);if(error){notice("msg","Could not load inventory: "+error.message,"error");return}render(data);notice("msg","✓ Inventory loaded.","success")}
async function save(){const rows=names.map((n,i)=>({owner_id:user.id,plant_name:n,seedling:+E("s"+i).value||0,growing:+E("g"+i).value||0,established:+E("e"+i).value||0,is_public:E("p"+i).checked}));
const {error}=await sb.from("Inventory").upsert(rows,{onConflict:"owner_id,plant_name"});if(error){notice("msg","Save failed: "+error.message,"error");return}notice("msg","✓ Inventory saved! The public website will now use these numbers.","success")}
function status(i){const t=(+E("s"+i).value||0)+(+E("g"+i).value||0)+(+E("e"+i).value||0),x=E("st"+i);if(t===0){x.textContent="○ Out of stock";x.className="status red"}else if(t<=2){x.textContent="● Limited";x.className="status yellow"}else{x.textContent="● Available";x.className="status green"}}
(()=>{const u=localStorage.getItem("tp_url"),k=localStorage.getItem("tp_key");if(u&&k){E("url").value=u;sb=window.supabase.createClient(u,k);E("setup").classList.add("hidden");E("login").classList.remove("hidden")}})();
</script>
</body></html>"""

(root/"index.html").write_text(index_html, encoding="utf-8")
(root/"dashboard.html").write_text(dashboard_html, encoding="utf-8")
